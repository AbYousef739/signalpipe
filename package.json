{
  "name": "signalpipe",
  "version": "2.0.3",
  "description": "Buying-intent scoring for AI agents. Score any text — Reddit, HN, RSS, email, Slack, Discord, support tickets — through a three-judge panel that separates real buyers from sellers, competitors and noise, then drafts a reply for your approval. MCP-native. The judgement runs on us, the sending runs on you.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "SKILL.md",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "clawhub",
    "mcp",
    "buyer-intent",
    "intent-scoring",
    "intent-classification",
    "buying-signals",
    "lead-generation",
    "lead-qualification",
    "sales-pipeline",
    "signal-detection",
    "prospect-nurturing",
    "churn-detection",
    "agentic",
    "human-in-the-loop",
    "reddit",
    "hacker-news",
    "rss"
  ],
  "author": "SignalPipe <contact@signalpipe.io>",
  "license": "MIT",
  "homepage": "https://signalpipe.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbYousef739/signalpipe.git"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "snoowrap": "^1.23.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "requires": {
      "env": [
        "SIGNALPIPE_API_URL",
        "SIGNALPIPE_OPERATOR_KEY"
      ]
    },
    "compat": {
      "pluginApi": ">=2026.4.5",
      "minGatewayVersion": "2026.4.5"
    },
    "build": {
      "openclawVersion": "2026.4.5",
      "pluginSdkVersion": "2026.4.5"
    }
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
